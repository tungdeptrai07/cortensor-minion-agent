{
  "action_policy": {
    "allow_read_only_without_prompt": true,
    "default_action": "require_confirm",
    "mode": "auto"
  },
  "agents": {
    "cortensor-ops": {
      "default_channel": "console",
      "name": "cortensor-ops",
      "provider": "openai",
      "provider_config_overrides": {
        "api_key": "local-cortensor-demo-key",
        "base_url": "http://127.0.0.1:11435/v1",
        "model": "cortensor-oss-20b-local",
        "temperature": 0.1,
        "timeout_seconds": 30,
        "tool_call_strategy": "native"
      },
      "system_prompt": "You are CortensorOps, a precision DePIN node auditor running on OpenMinion.",
      "thinking": "minimal"
    }
  },
  "default_agent": "cortensor-ops",
  "enabled_channels": [
    "console"
  ],
  "providers": {
    "openai": {
      "api_key": "local-cortensor-demo-key",
      "base_url": "http://127.0.0.1:11435/v1",
      "model": "cortensor-oss-20b-local",
      "temperature": 0.1,
      "timeout_seconds": 30,
      "tool_call_strategy": "native"
    },
    "cortensor": {
      "api_key": "",
      "api_key_env": "CORTENSOR_API_KEY",
      "api_mode": "auto",
      "base_url": "http://127.0.0.1:8080/api/v2/completions",
      "model": "gpt-oss-20b",
      "session_id": 1,
      "tool_call_strategy": "hybrid"
    }
  },
  "runtime": {
    "demo_mode": false,
    "memory_enabled": true
  },
  "storage": {
    "backend": "sqlite"
  }
}
